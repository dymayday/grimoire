+    }
+    fn draw_title_with_state(
+        width: u16,
+        reasoning_effort: Option<&str>,
+        is_running: bool,
+    ) -> String {
+        let mut parent = make_agent();
+        let mut info = running_subagent_info("child");
+        info.description = "review changes".into();
+        info.model = Some("grok-4.6".into());
+        info.reasoning_effort = reasoning_effort.map(Into::into);
+        info.started_at -= std::time::Duration::from_secs(120);
+        if !is_running {
+            info.finished = true;
+            info.status = Some("completed".into());
+        }
+        parent.subagent_sessions.insert("child".into(), info);
+        let mut child = make_agent();
+        if is_running {
+            child.session.state = crate::app::agent::AgentState::TurnRunning;
+        }
+        parent
+            .subagent_views
+            .insert("child".into(), Box::new(child));
+        parent.active_subagent = Some("child".into());
+        let area = Rect::new(0, 0, width, 20);
+        let mut buf = Buffer::empty(area);
+        let mut scratch = ScratchBuffer::new();
+        let _ = parent.draw(
+            area,
+            &mut buf,
+            &ActionRegistry::defaults(),
+            &mut scratch,
+            None,
+            false,
+            crate::app::agent_view::BannerSlotParams::none(),
+            &BundleState::default(),
+            false,
+            false,
+            &mut Vec::new(),
+            super::AppRenderParams::default(),
