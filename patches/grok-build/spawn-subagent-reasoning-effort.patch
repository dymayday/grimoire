+const FALLBACK_REASONING_EFFORTS: &[ReasoningEffort] =
+    &crate::agent::session_config::SELECTABLE_REASONING_EFFORTS;
+
+pub(super) fn apply_reasoning_effort_override(
+    config: &mut xai_grok_sampler::SamplerConfig,
+    raw_effort: Option<&str>,
+    model_id: &str,
+    supports_reasoning_effort: bool,
+    offered_efforts: &[ReasoningEffortOption],
+    is_explicit_override: bool,
+) -> Result<(), String> {
+    let Some(raw_effort) = raw_effort else {
+        return Ok(());
+    };
+    if !supports_reasoning_effort {
+        if is_explicit_override {
+            return Err(format!(
+                "Cannot apply reasoning_effort '{raw_effort}': model '{model_id}' does not support \
+                 reasoning effort. Omit reasoning_effort or select a supporting model."
+            ));
+        }
+        return Ok(());
+    }
+    let effort = match raw_effort.parse::<ReasoningEffort>() {
+        Ok(effort) => effort,
+        Err(error) => {
+            if is_explicit_override {
+                return Err(format!(
+                    "Invalid resolved reasoning_effort {raw_effort:?}: {error}"
+                ));
+            }
+            tracing::warn!(
+                value = raw_effort,
+                error = %error,
+                "subagent reasoning_effort: parse failed, ignoring override"
+            );
+            return Ok(());
+        }
+    };
+    let is_offered = if offered_efforts.is_empty() {
+        FALLBACK_REASONING_EFFORTS.contains(&effort)
+    } else {
+        offered_efforts.iter().any(|option| option.value == effort)
+    };
+    if is_explicit_override && !is_offered {
+        let available = if offered_efforts.is_empty() {
+            FALLBACK_REASONING_EFFORTS
+                .iter()
+                .map(|effort| effort.as_str())
+                .collect::<Vec<_>>()
+                .join(", ")
+        } else {
+            offered_efforts
+                .iter()
+                .map(|option| option.value.as_str())
+                .collect::<Vec<_>>()
+                .join(", ")
+        };
+        return Err(format!(
+            "Cannot apply reasoning_effort '{raw_effort}': model '{model_id}' offers: {available}"
+        ));
+    }
+    config.reasoning_effort = Some(effort);
+    Ok(())
+}
