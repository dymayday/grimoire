+/// Fit type, description, and runtime meta into `avail` columns.
+/// Meta is reserved first so model/effort stay visible and separated from
+/// the right-side controls; type is kept whole or dropped; description
+/// takes whatever remains.
+fn fit_fullscreen_subagent_title(
+    avail: usize,
+    type_label: &str,
+    description: &str,
+    meta: &str,
+) -> (String, String, String) {
+    use unicode_width::UnicodeWidthStr;
+    let mut type_text = type_label.to_string();
+    if !type_text.is_empty() && !description.is_empty() {
+        type_text.push(' ');
+    }
+    let meta_text = if meta.is_empty() {
+        String::new()
+    } else {
+        format!(" {meta}")
+    };
+    let meta_display = truncate_str(&meta_text, avail);
+    let text_avail = avail.saturating_sub(meta_display.width());
+    let type_display = if type_text.width() <= text_avail {
+        type_text
+    } else {
+        String::new()
+    };
+    let desc_max = text_avail.saturating_sub(type_display.width());
+    let desc_display = truncate_str(description, desc_max);
+    (type_display, desc_display, meta_display)
+}
