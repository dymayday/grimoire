+fn apply_test_reasoning_effort(
+    raw: &str,
+    supports_reasoning_effort: bool,
+    offered: &[ReasoningEffortOption],
+    is_explicit_override: bool,
+) -> (SamplerConfig, Result<(), String>) {
+    let mut config = SamplerConfig::default();
+    let result = apply_reasoning_effort_override(
+        &mut config,
+        Some(raw),
+        "test-model",
+        supports_reasoning_effort,
+        offered,
+        is_explicit_override,
+    );
+    (config, result)
+}
+
+#[test]
+fn reasoning_effort_override_applies_to_supporting_model() {
+    let (config, result) = apply_test_reasoning_effort("high", true, &[], true);
+    result.unwrap();
+    assert_eq!(
+        config.reasoning_effort,
+        Some(ReasoningEffort::High)
+    );
+}
+
+#[test]
+fn reasoning_effort_override_rejects_unsupported_model() {
+    let (config, result) = apply_test_reasoning_effort("high", false, &[], true);
+    let error = result.unwrap_err();
+    assert!(error.contains("does not support reasoning effort"));
+    assert!(config.reasoning_effort.is_none());
+}
+
+#[test]
+fn reasoning_effort_override_inherited_is_ignored_for_unsupported_model() {
+    let (config, result) = apply_test_reasoning_effort("high", false, &[], false);
+    result.unwrap();
+    assert!(config.reasoning_effort.is_none());
+}
+
+#[test]
+fn reasoning_effort_override_enforces_model_menu() {
+    let offered = [ReasoningEffortOption {
+        id: "balanced".into(),
+        value: ReasoningEffort::Medium,
+        label: "Balanced".into(),
+        description: None,
+        default: true,
+    }];
+
+    let (config, result) = apply_test_reasoning_effort("medium", true, &offered, true);
+    result.unwrap();
+    assert_eq!(config.reasoning_effort, Some(ReasoningEffort::Medium));
+
+    let (config, result) = apply_test_reasoning_effort("high", true, &offered, true);
+    let error = result.unwrap_err();
+    assert!(error.contains("offers: medium"));
+    assert!(config.reasoning_effort.is_none());
+}
+
+#[test]
+fn reasoning_effort_override_enforces_fallback_model_menu() {
+    for effort in ["minimal", "low", "medium", "high", "xhigh"] {
+        let (config, result) = apply_test_reasoning_effort(effort, true, &[], true);
+        result.unwrap();
+        assert_eq!(config.reasoning_effort.unwrap().as_str(), effort);
+    }
+
+    for effort in ["none", "max"] {
+        let (config, result) = apply_test_reasoning_effort(effort, true, &[], true);
+        let error = result.unwrap_err();
+        assert!(error.contains("offers: minimal, low, medium, high, xhigh"));
+        assert!(config.reasoning_effort.is_none());
+    }
+}
+
+#[test]
+fn reasoning_effort_override_inherited_ignores_model_menu() {
+    let offered = [ReasoningEffortOption {
+        id: "balanced".into(),
+        value: ReasoningEffort::Medium,
+        label: "Balanced".into(),
+        description: None,
+        default: true,
